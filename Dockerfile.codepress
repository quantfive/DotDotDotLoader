# Generated by CodePress bootstrap-app-server.
# Edits are preserved, but running /bootstrap-app-server again may overwrite them.

# Node 16 ships OpenSSL 1.1.1, which the legacy webpack 3 / babel 6 build
# toolchain in this repo requires (newer Node throws ERR_OSSL_EVP_UNSUPPORTED).
FROM node:16-bullseye-slim
WORKDIR /usr/src/app

# Install dependencies first for layer caching.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --no-progress

# Bundle app source.
COPY . .

# The app imports its loader component from src/node_modules (a legacy CRA
# module-resolution pattern). The Docker build context filter strips every
# directory named node_modules at any depth, so src/node_modules never arrives
# via COPY. Reconstruct it from lib/ — the committed, babel-compiled mirror of
# src/node_modules (built by `yarn lib`) with an identical file tree. This keeps
# the build self-contained without modifying application source.
RUN cp -r lib src/node_modules && ls -la src/node_modules

# Build the production React bundle (Create React App / webpack 3).
RUN yarn build

# The Express server in server/ serves the build/ output.
ENV PORT=3000
EXPOSE 3000
CMD ["yarn", "serve"]
