# Generated by CodePress bootstrap-app-server.
# Edits are preserved, but running /bootstrap-app-server again may overwrite them.
FROM node:18-slim

WORKDIR /app

# Copy package manifests for layer caching
COPY package.json package-lock.json ./

# Install all dependencies (dev deps required for webpack build step)
RUN npm ci

# Copy source files
COPY . .

# Build the React app
RUN npm run build

EXPOSE 3000

# Start Express server directly (avoids npm exec fallback path)
CMD ["node", "server/index.js"]
